PORT=8765
NODE_ENV=production
ADMIN_PASSWORD=change-me-strong-password
SESSION_SECRET=change-this-to-a-long-random-secret-32chars
# Cookies Secure (auto si NODE_ENV=production)
COOKIE_SECURE=1
# Derrière Nginx / Caddy / Cloudflare
TRUST_PROXY=1
# Redirige HTTP → HTTPS (mets 1 derrière Nginx sur ton VPS)
FORCE_HTTPS=0
